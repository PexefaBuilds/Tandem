{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tandem",
  "version": "1.2.1",
  "identifier": "app.tandem.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tandem",
        "width": 1280,
        "height": 800,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "visible": false
      }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA1RkI0RjI0OTMwOTExM0QKUldROUVRbVRKRS83QlJRcW1FWTEzTmNjaE0zVlcvLzN1UGQ3b3ZtNW03bE9RYWZiRkVuSlFpcHMK",
      "endpoints": ["https://github.com/PexefaBuilds/Tandem/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
